   "source": [
    "#1.Dice Roll game\n",
    "import random\n",
    "dice_C = [1,2,3,4,5,6]\n",
    "dice_H = [1,2,3,4,5,6]\n",
    "print(\"Computer:\")\n",
    "computer = random.choice(dice_C)\n",
    "print(computer)\n",
    "print(\"Player:\")\n",
    "human = random.choice(dice_H)\n",
    "print(human)\n",
    "if human > computer  :\n",
    "    print(\"You won\")\n",
    "else:\n",
    "    print(\"You Lose\")"
   ]
  }
