    "# 1. Attendance Percentage Calculator\n",
    "total_classes = 45\n",
    "attended_class = int(input(\"Enter the no. of classes attended\"))\n",
    "percentage = (attended_class/total_classes)*100\n",
    "print(percentage)\n",
    "if percentage >= 75:\n",
    "    print(\"Eligible for exam\")\n",
    "else:\n",
    "    print(\"You are not eligible\")"
   ]
